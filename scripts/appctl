#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GO_DIR="${ROOT_DIR}/go-api"
BIN_DIR="${GO_DIR}/bin"
RUN_DIR="${GO_DIR}/run"
BIN_PATH="${BIN_DIR}/forest"
PID_PATH="${RUN_DIR}/forest.pid"
LOG_PATH="${RUN_DIR}/forest.log"
GO_BIN="${GO_BIN:-go}"
GIT_BIN="${GIT_BIN:-git}"
PGREP_BIN="${PGREP_BIN:-pgrep}"
LOCAL_TOOL_DIR="${ROOT_DIR}/.local"
LOCAL_GO_ROOT="${LOCAL_TOOL_DIR}/go"
LOCAL_GO_BIN="${LOCAL_GO_ROOT}/bin/go"
LOCAL_GO_PATH="${LOCAL_TOOL_DIR}/gopath"
LOCAL_GO_MOD_CACHE="${LOCAL_TOOL_DIR}/gomodcache"
LOCAL_GO_BUILD_CACHE="${LOCAL_TOOL_DIR}/gocache"
LOCAL_HOME_DIR="${LOCAL_TOOL_DIR}/home"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
FOREST_SERVICE_NAME="${FOREST_SERVICE_NAME:-forest}"
FOREST_SERVICE_FILE_PATH="${FOREST_SERVICE_FILE_PATH:-/etc/systemd/system/${FOREST_SERVICE_NAME}.service}"
LEGACY_FOREST_SERVICE_NAME="${LEGACY_FOREST_SERVICE_NAME:-forest-go-api}"
LEGACY_FOREST_SERVICE_FILE_PATH="${LEGACY_FOREST_SERVICE_FILE_PATH:-/etc/systemd/system/${LEGACY_FOREST_SERVICE_NAME}.service}"

mkdir -p "${BIN_DIR}" "${RUN_DIR}"

cleanup_legacy_runtime_artifacts() {
  local quiet="${1:-false}"
  local removed=0
  local artifact

  for artifact in \
    "${ROOT_DIR}/workerman.log" \
    "${ROOT_DIR}/workerman.webman.php.pid"
  do
    if [[ -e "${artifact}" ]]; then
      rm -f "${artifact}"
      removed=$((removed + 1))
    fi
  done

  if [[ "${quiet}" != "true" ]]; then
    echo "已清理 ${removed} 个旧版运行残留文件"
  fi
}

prepare_go_env() {
  export HOME="${HOME:-${LOCAL_HOME_DIR}}"
  export GOPATH="${GOPATH:-${LOCAL_GO_PATH}}"
  export GOMODCACHE="${GOMODCACHE:-${LOCAL_GO_MOD_CACHE}}"
  export GOCACHE="${GOCACHE:-${LOCAL_GO_BUILD_CACHE}}"
  export GOPROXY="${GOPROXY:-https://goproxy.cn,direct}"
  if [[ " ${GOFLAGS:-} " != *" -modcacherw "* ]]; then
    export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-modcacherw"
  fi
  mkdir -p "${HOME}" "${GOPATH}" "${GOMODCACHE}" "${GOCACHE}"
}

ensure_go() {
  prepare_go_env
  if command -v "${GO_BIN}" >/dev/null 2>&1; then
    GO_BIN="$(command -v "${GO_BIN}")"
    return 0
  fi

  if [[ "${GO_BIN}" != "go" ]]; then
    echo "找不到指定的 GO_BIN：${GO_BIN}"
    exit 1
  fi

  if [[ -x "${LOCAL_GO_BIN}" ]]; then
    GO_BIN="${LOCAL_GO_BIN}"
    return 0
  fi

  bootstrap_local_go
  if [[ ! -x "${LOCAL_GO_BIN}" ]]; then
    echo "本地 Go 工具链初始化失败"
    exit 1
  fi
  GO_BIN="${LOCAL_GO_BIN}"
}

required_go_version() {
  awk '/^go / { print $2; exit }' "${GO_DIR}/go.mod"
}

detect_go_bootstrap_os() {
  case "$(uname -s)" in
    Linux) printf 'linux\n' ;;
    Darwin) printf 'darwin\n' ;;
    *)
      echo "当前系统暂不支持自动安装 Go：$(uname -s)" >&2
      exit 1
      ;;
  esac
}

detect_go_bootstrap_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64\n' ;;
    arm64|aarch64) printf 'arm64\n' ;;
    *)
      echo "当前 CPU 架构暂不支持自动安装 Go：$(uname -m)" >&2
      exit 1
      ;;
  esac
}

download_file() {
  local url="$1"
  local output="$2"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${url}" -o "${output}"
    return 0
  fi

  if command -v wget >/dev/null 2>&1; then
    wget -qO "${output}" "${url}"
    return 0
  fi

  echo "自动安装 Go 需要 curl 或 wget" >&2
  exit 1
}

git_available() {
  command -v "${GIT_BIN}" >/dev/null 2>&1
}

git_repo_available() {
  git_available || return 1
  "${GIT_BIN}" -C "${ROOT_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

git_head_short() {
  git_available || return 1
  "${GIT_BIN}" -C "${ROOT_DIR}" rev-parse --short=7 HEAD 2>/dev/null | tail -n 1
}

update_source_code_from_git() {
  git_repo_available || return 0

  local old_head new_head
  old_head="$(git_head_short || true)"
  if ! "${GIT_BIN}" -C "${ROOT_DIR}" pull --ff-only --quiet; then
    echo "代码拉取失败，请先处理本地改动、冲突或网络问题后重试" >&2
    exit 1
  fi

  new_head="$(git_head_short || true)"
  if [[ -n "${new_head}" ]] && [[ "${new_head}" != "${old_head}" ]]; then
    echo "代码已更新 ${old_head:-unknown} -> ${new_head}"
    return 0
  fi
  if [[ -n "${new_head}" ]]; then
    echo "代码已是最新版本 (${new_head})"
    return 0
  fi
  echo "代码拉取完成"
}

print_update_step() {
  local step="$1"
  local message="$2"
  printf '[%s] %s\n' "${step}" "${message}"
}

print_update_summary() {
  local result="$1"
  echo "更新完成"
  case "${result}" in
    restarted)
      echo "服务已重启完成"
      ;;
    started)
      echo "服务已启动完成"
      ;;
    stopped)
      echo "服务当前未启动，如需立即生效请执行 ./scripts/appctl start"
      ;;
  esac
}

bootstrap_local_go() {
  local version os arch url archive extract_dir
  version="${GO_BOOTSTRAP_VERSION:-$(required_go_version)}"
  os="${GO_BOOTSTRAP_OS:-$(detect_go_bootstrap_os)}"
  arch="${GO_BOOTSTRAP_ARCH:-$(detect_go_bootstrap_arch)}"
  url="${GO_BOOTSTRAP_URL:-https://go.dev/dl/go${version}.${os}-${arch}.tar.gz}"
  archive="${LOCAL_TOOL_DIR}/go${version}.${os}-${arch}.tar.gz"
  extract_dir="${LOCAL_TOOL_DIR}/.go-extract.$$"

  if ! command -v tar >/dev/null 2>&1; then
    echo "自动安装 Go 需要 tar" >&2
    exit 1
  fi

  mkdir -p "${LOCAL_TOOL_DIR}"
  rm -rf "${extract_dir}" "${LOCAL_GO_ROOT}"

  echo "正在初始化本地 Go 工具链 ${version} 到 ${LOCAL_GO_ROOT}" >&2
  download_file "${url}" "${archive}"
  mkdir -p "${extract_dir}"
  tar -C "${extract_dir}" -xzf "${archive}"

  if [[ ! -x "${extract_dir}/go/bin/go" ]]; then
    echo "自动安装 Go 失败：解压结果中缺少 go/bin/go" >&2
    rm -rf "${extract_dir}" "${archive}"
    exit 1
  fi

  mv "${extract_dir}/go" "${LOCAL_GO_ROOT}"
  rm -rf "${extract_dir}" "${archive}"
}

env_file_looks_legacy_stack() {
  local path="$1"
  [[ -f "${path}" ]] || return 1

  if grep -Eq '^[[:space:]]*DB_CONNECTION=mysql([[:space:]]*)$' "${path}"; then
    return 0
  fi
  if grep -Eq '^[[:space:]]*(REDIS_HOST|REDIS_PORT|REDIS_PASSWORD|QUEUE_CONNECTION)=' "${path}"; then
    return 0
  fi
  return 1
}

resolve_env_path() {
  local go_env="${ROOT_DIR}/.env.go"
  local legacy_env="${ROOT_DIR}/.env"

  if [[ -f "${go_env}" ]]; then
    printf '%s\n' "${go_env}"
    return 0
  fi
  if [[ -f "${legacy_env}" ]] && ! env_file_looks_legacy_stack "${legacy_env}"; then
    printf '%s\n' "${legacy_env}"
    return 0
  fi
  printf '%s\n' "${go_env}"
}

resolve_env_example_path() {
  local env_path
  env_path="$(resolve_env_path)"
  if [[ "${env_path}" == "${ROOT_DIR}/.env.go" ]] && [[ -f "${ROOT_DIR}/.env.go.example" ]]; then
    printf '%s\n' "${ROOT_DIR}/.env.go.example"
    return 0
  fi
  printf '%s\n' "${ROOT_DIR}/.env.example"
}

ensure_env_file() {
  local env_path
  env_path="$(resolve_env_path)"
  if [[ ! -f "${env_path}" ]]; then
    cp "$(resolve_env_example_path)" "${env_path}"
    if [[ "${env_path}" == "${ROOT_DIR}/.env.go" ]]; then
      copy_shared_env_from_legacy_stack "${env_path}"
    fi
  fi
}

load_env_from_path() {
  local env_path="$1"
  [[ -f "${env_path}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" ]] && continue
    [[ "${line}" =~ ^[[:space:]]*# ]] && continue
    [[ "${line}" != *=* ]] && continue

    local key="${line%%=*}"
    local value="${line#*=}"

    key="$(printf '%s' "${key}" | tr -d '[:space:]')"
    value="${value%$'\r'}"

    if [[ "${value}" =~ ^\".*\"$ ]] || [[ "${value}" =~ ^\'.*\'$ ]]; then
      value="${value:1:${#value}-2}"
    fi

    export "${key}=${value}"
  done < "${env_path}"
}

load_env() {
  ensure_env_file
  load_env_from_path "$(resolve_env_path)"
}

load_env_if_present() {
  local env_path
  env_path="$(resolve_env_path)"
  if [[ -f "${env_path}" ]]; then
    load_env_from_path "${env_path}"
  fi
}

env_value_from_path() {
  local env_path="$1"
  local target_key="$2"
  [[ -f "${env_path}" ]] || return 0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" ]] && continue
    [[ "${line}" =~ ^[[:space:]]*# ]] && continue
    [[ "${line}" != *=* ]] && continue

    local key="${line%%=*}"
    local value="${line#*=}"

    key="$(printf '%s' "${key}" | tr -d '[:space:]')"
    value="${value%$'\r'}"
    if [[ "${key}" != "${target_key}" ]]; then
      continue
    fi

    if [[ "${value}" =~ ^\".*\"$ ]] || [[ "${value}" =~ ^\'.*\'$ ]]; then
      value="${value:1:${#value}-2}"
    fi
    printf '%s\n' "${value}"
    return 0
  done < "${env_path}"
}

legacy_mysql_env_path() {
  legacy_mysql_env_path_from_root "${ROOT_DIR}"
}

legacy_mysql_env_path_from_root() {
  local legacy_root="$1"
  local legacy_env="${legacy_root}/.env"
  if env_file_looks_legacy_stack "${legacy_env}"; then
    printf '%s\n' "${legacy_env}"
  fi
}

legacy_mysql_root_from_input() {
  local input_path="${1:-}"

  if [[ -z "${input_path}" ]]; then
    echo "必须提供旧项目目录或旧版 .env 路径" >&2
    exit 1
  fi

  if [[ -d "${input_path}" ]]; then
    (
      cd "${input_path}"
      pwd
    )
    return 0
  fi

  if [[ -f "${input_path}" && "$(basename "${input_path}")" == ".env" ]]; then
    (
      cd "$(dirname "${input_path}")"
      pwd
    )
    return 0
  fi

  echo "旧项目路径不存在，或不是目录/旧版 .env 文件：${input_path}" >&2
  exit 1
}

legacy_mysql_configured() {
  local legacy_env
  legacy_env="$(legacy_mysql_env_path)"
  [[ -n "${legacy_env}" ]] || return 1

  local connection database username
  connection="$(env_value_from_path "${legacy_env}" "DB_CONNECTION")"
  database="$(env_value_from_path "${legacy_env}" "DB_DATABASE")"
  username="$(env_value_from_path "${legacy_env}" "DB_USERNAME")"

  if [[ -n "${connection}" && "${connection}" != "mysql" ]]; then
    return 1
  fi
  [[ -n "${database}" && -n "${username}" ]]
}

legacy_mysql_default_value() {
  local key="$1"
  local fallback="${2:-}"
  local legacy_env value
  legacy_env="$(legacy_mysql_env_path || true)"
  if [[ -n "${legacy_env}" ]]; then
    value="$(env_value_from_path "${legacy_env}" "${key}")"
    if [[ -n "${value}" ]]; then
      printf '%s\n' "${value}"
      return 0
    fi
  fi
  printf '%s\n' "${fallback}"
}

merge_mysql_profile_path() {
  local override="${FOREST_MERGE_MYSQL_PROFILE:-}"
  if [[ -n "${override}" ]]; then
    [[ -f "${override}" ]] || return 1
    printf '%s\n' "${override}"
    return 0
  fi

  local candidate="/etc/forest/merge-mysql.env"
  if [[ -f "${candidate}" ]]; then
    printf '%s\n' "${candidate}"
    return 0
  fi

  candidate="${ROOT_DIR}/.merge-mysql.env"
  if [[ -f "${candidate}" ]]; then
    printf '%s\n' "${candidate}"
    return 0
  fi
  return 1
}

merge_mysql_profile_value() {
  local key="$1"
  local fallback="${2:-}"
  local value="${!key:-}"
  if [[ -n "${value}" ]]; then
    printf '%s\n' "${value}"
    return 0
  fi

  local profile_path
  profile_path="$(merge_mysql_profile_path || true)"
  if [[ -n "${profile_path}" ]]; then
    value="$(env_value_from_path "${profile_path}" "${key}")"
    if [[ -n "${value}" ]]; then
      printf '%s\n' "${value}"
      return 0
    fi
  fi

  printf '%s\n' "${fallback}"
}

merge_mysql_source_default_value() {
  local profile_key="$1"
  local legacy_key="$2"
  local fallback="${3:-}"
  local value=""

  value="$(merge_mysql_profile_value "${profile_key}")"
  if [[ -n "${value}" ]]; then
    printf '%s\n' "${value}"
    return 0
  fi

  legacy_mysql_default_value "${legacy_key}" "${fallback}"
}

merge_mysql_source_preset_ready() {
  local source_database source_username source_password
  source_database="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_DATABASE" "DB_DATABASE")"
  source_username="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_USERNAME" "DB_USERNAME")"
  source_password="$(merge_mysql_profile_value "MERGE_MYSQL_SOURCE_PASSWORD" "$(legacy_mysql_default_value "DB_PASSWORD")")"
  [[ -n "${source_database}" && -n "${source_username}" && -n "${source_password}" ]]
}

merge_mysql_plan_map_lookup() {
  local raw="$1"
  local source_plan_id="$2"
  local token source_id target_id

  while IFS= read -r token || [[ -n "${token}" ]]; do
    token="$(printf '%s' "${token}" | tr -d '[:space:]')"
    [[ -n "${token}" ]] || continue
    [[ "${token}" == *:* ]] || continue
    source_id="${token%%:*}"
    target_id="${token#*:}"
    if [[ "${source_id}" == "${source_plan_id}" && -n "${target_id}" ]]; then
      printf '%s\n' "${target_id}"
      return 0
    fi
  done < <(printf '%s' "${raw}" | tr ',\r\n\t' '\n')

  return 1
}

merge_mysql_target_dsn_value() {
  local value="${MERGE_MYSQL_TARGET_DSN:-}"
  if [[ -n "${value}" ]]; then
    printf '%s\n' "${value}"
    return 0
  fi
  merge_mysql_profile_value "MERGE_MYSQL_TARGET_DSN"
}

resolve_merge_mysql_postgres_dsn() {
  if [[ -z "${POSTGRES_DSN:-}" ]]; then
    local merge_target_dsn=""
    merge_target_dsn="$(merge_mysql_target_dsn_value)"
    if [[ -n "${merge_target_dsn}" ]]; then
      export POSTGRES_DSN="${merge_target_dsn}"
    fi
  fi
  resolve_postgres_dsn
}

resolve_merge_mysql_target_plan_id() {
  local mapping_input="$1"
  shift

  local target_item target_id target_name target_user_count
  if [[ "${mapping_input}" =~ ^[0-9]+$ ]]; then
    for target_item in "$@"; do
      IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
      if [[ "${mapping_input}" == "${target_id}" ]]; then
        printf '%s\n' "${target_id}"
        return 0
      fi
    done
    return 1
  fi

  for target_item in "$@"; do
    IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
    if [[ "${mapping_input}" == "${target_name}" ]]; then
      printf '%s\n' "${target_id}"
      return 0
    fi
  done
  return 1
}

should_prompt_db_config() {
  if [[ "${FORCE_INTERACTIVE_DB_CONFIG:-0}" == "1" ]]; then
    return 0
  fi
  [[ -t 0 && -t 1 ]]
}

db_configured() {
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    return 0
  fi
  [[ -n "${DB_DATABASE:-}" && -n "${DB_USERNAME:-}" ]]
}

set_env_var() {
  local key="$1"
  local value="$2"
  ensure_env_file
  local env_path
  env_path="$(resolve_env_path)"
  set_env_var_in_path "${env_path}" "${key}" "${value}"
}

set_env_var_in_path() {
  local env_path="$1"
  local key="$2"
  local value="$3"
  local tmp="${env_path}.tmp.$$"
  awk -v k="$key" -v v="$value" '
    BEGIN { done = 0 }
    $0 ~ ("^" k "=") { print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "${env_path}" > "${tmp}"
  mv "${tmp}" "${env_path}"
}

copy_shared_env_from_legacy_env() {
  local env_path="$1"
  local legacy_env="$2"
  local key legacy_value
  for key in \
    APP_NAME \
    APP_KEY \
    APP_URL \
    ADMIN_EMAIL \
    ADMIN_PASSWORD \
    EMAIL_VERIFY \
    INVITE_FORCE \
    LOGIN_WITH_MAIL_LINK_ENABLE \
    EMAIL_HOST \
    EMAIL_PORT \
    EMAIL_USERNAME \
    EMAIL_PASSWORD \
    EMAIL_ENCRYPTION \
    EMAIL_FROM_ADDRESS \
    EMAIL_FROM_NAME
  do
    legacy_value="$(env_value_from_path "${legacy_env}" "${key}")"
    [[ -n "${legacy_value}" ]] || continue
    set_env_var_in_path "${env_path}" "${key}" "${legacy_value}"
  done
}

copy_shared_env_from_legacy_stack() {
  local env_path="$1"
  local legacy_env
  legacy_env="$(legacy_mysql_env_path)"
  [[ -n "${legacy_env}" ]] || return 0
  copy_shared_env_from_legacy_env "${env_path}" "${legacy_env}"
}

dsn_value_from_url() {
  local dsn="$1"
  local field="$2"

  if [[ ! "${dsn}" =~ ^postgres(ql)?:// ]]; then
    return 1
  fi

  local without_scheme="${dsn#postgres://}"
  without_scheme="${without_scheme#postgresql://}"

  local creds_host="${without_scheme%%/*}"
  local rest="${without_scheme#*/}"
  local database="${rest%%\?*}"
  local query=""
  if [[ "${rest}" == *\?* ]]; then
    query="${rest#*\?}"
  fi

  local creds=""
  local host_port="${creds_host}"
  if [[ "${creds_host}" == *"@"* ]]; then
    creds="${creds_host%@*}"
    host_port="${creds_host#*@}"
  fi

  local username=""
  local password=""
  if [[ -n "${creds}" ]]; then
    username="${creds%%:*}"
    if [[ "${creds}" == *:* ]]; then
      password="${creds#*:}"
    fi
  fi

  local host="${host_port%%:*}"
  local port=""
  if [[ "${host_port}" == *:* ]]; then
    port="${host_port##*:}"
  fi

  local sslmode=""
  if [[ -n "${query}" ]]; then
    local pair
    IFS='&' read -r -a pairs <<< "${query}"
    for pair in "${pairs[@]}"; do
      if [[ "${pair}" == sslmode=* ]]; then
        sslmode="${pair#sslmode=}"
        break
      fi
    done
  fi

  case "${field}" in
    host) printf '%s\n' "${host}" ;;
    port) printf '%s\n' "${port}" ;;
    database) printf '%s\n' "${database}" ;;
    username) printf '%s\n' "${username}" ;;
    password) printf '%s\n' "${password}" ;;
    sslmode) printf '%s\n' "${sslmode}" ;;
    *) return 1 ;;
  esac
}

dsn_value_from_kv() {
  local dsn="$1"
  local field="$2"
  local key=""
  case "${field}" in
    host) key="host" ;;
    port) key="port" ;;
    database) key="dbname" ;;
    username) key="user" ;;
    password) key="password" ;;
    sslmode) key="sslmode" ;;
    *) return 1 ;;
  esac

  tr ' ' '\n' <<< "${dsn}" | awk -F= -v k="${key}" '$1 == k {print substr($0, index($0, "=") + 1); exit}'
}

current_db_value() {
  local field="$1"
  local direct=""
  case "${field}" in
    host) direct="${DB_HOST:-}" ;;
    port) direct="${DB_PORT:-}" ;;
    database) direct="${DB_DATABASE:-}" ;;
    username) direct="${DB_USERNAME:-}" ;;
    password) direct="${DB_PASSWORD:-}" ;;
    sslmode) direct="${DB_SSLMODE:-}" ;;
  esac

  if [[ -n "${direct}" ]]; then
    printf '%s\n' "${direct}"
    return 0
  fi

  if [[ -z "${POSTGRES_DSN:-}" ]]; then
    return 0
  fi

  local parsed=""
  parsed="$(dsn_value_from_url "${POSTGRES_DSN}" "${field}" 2>/dev/null || true)"
  if [[ -z "${parsed}" ]]; then
    parsed="$(dsn_value_from_kv "${POSTGRES_DSN}" "${field}" 2>/dev/null || true)"
  fi
  printf '%s\n' "${parsed}"
}

prompt_with_default() {
  local prompt="$1"
  local default_value="$2"
  local value=""

  if [[ -n "${default_value}" ]]; then
    printf '%s [%s]: ' "${prompt}" "${default_value}" >&2
  else
    printf '%s: ' "${prompt}" >&2
  fi
  IFS= read -r value || true
  if [[ -z "${value}" ]]; then
    value="${default_value}"
  fi
  printf '%s\n' "${value}"
}

prompt_secret_with_default() {
  local prompt="$1"
  local default_value="$2"
  local value=""

  if [[ -n "${default_value}" ]]; then
    printf '%s [已保存]: ' "${prompt}" >&2
  else
    printf '%s: ' "${prompt}" >&2
  fi
  IFS= read -r -s value || true
  printf '\n' >&2
  if [[ -z "${value}" ]]; then
    value="${default_value}"
  fi
  printf '%s\n' "${value}"
}

normalize_yes_no_answer() {
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]'
}

mysql_force_overwrite_enabled() {
  local value
  value="$(normalize_yes_no_answer "${FORCE_MYSQL_OVERWRITE:-}")"
  [[ "${value}" == "1" || "${value}" == "true" || "${value}" == "y" || "${value}" == "yes" ]]
}

confirm_migrate_legacy_mysql() {
  if mysql_force_overwrite_enabled; then
    return 0
  fi
  if ! should_prompt_db_config; then
    return 0
  fi

  local answer=""
  printf '检测到本地旧版 .env 文件，是否迁移旧版 MySQL 数据到 PostgreSQL？ [Y/n]: ' >&2
  IFS= read -r answer || true
  answer="$(normalize_yes_no_answer "${answer}")"
  if [[ -z "${answer}" || "${answer}" == "y" || "${answer}" == "yes" ]]; then
    return 0
  fi

  echo "已跳过旧版 MySQL 数据迁移"
  return 1
}

confirm_reset_postgres_target() {
  local answer=""
  printf '检测到 PostgreSQL 目标库已有数据，是否清空 PostgreSQL 并用 MySQL 全量覆盖？ [y/N]: ' >&2
  IFS= read -r answer || true
  answer="$(normalize_yes_no_answer "${answer}")"
  [[ "${answer}" == "y" || "${answer}" == "yes" ]]
}

build_postgres_dsn_value() {
  local host="$1"
  local port="$2"
  local database="$3"
  local username="$4"
  local password="$5"
  local sslmode="$6"

  if [[ -n "${password}" ]]; then
    printf 'host=%s port=%s user=%s dbname=%s sslmode=%s password=%s\n' \
      "${host}" "${port}" "${username}" "${database}" "${sslmode}" "${password}"
    return 0
  fi

  printf 'host=%s port=%s user=%s dbname=%s sslmode=%s\n' \
    "${host}" "${port}" "${username}" "${database}" "${sslmode}"
}

cmd_prompt_db() {
  local optional=false
  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --optional) optional=true ;;
      *)
        echo "未知的 prompt-db 参数：${1}" >&2
        exit 1
        ;;
    esac
    shift
  done

  load_env

  if [[ "${optional}" == "true" ]]; then
    local default_answer="y"
    local prompt_label="[Y/n]"
    if db_configured; then
      default_answer="n"
      prompt_label="[y/N]"
    fi
    printf '更新前是否修改 PostgreSQL 配置？ %s: ' "${prompt_label}" >&2
    local answer=""
    IFS= read -r answer || true
    answer="$(printf '%s' "${answer}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
    if [[ -z "${answer}" ]]; then
      answer="${default_answer}"
    fi
    if [[ "${answer}" != "y" && "${answer}" != "yes" ]]; then
      echo "已跳过 PostgreSQL 配置更新"
      return 0
    fi
  fi

  local host port database username password sslmode dsn
  host="$(prompt_with_default "PostgreSQL 主机 (DB_HOST)" "$(current_db_value host)")"
  host="${host:-127.0.0.1}"
  port="$(prompt_with_default "PostgreSQL 端口 (DB_PORT)" "$(current_db_value port)")"
  port="${port:-5432}"
  database="$(prompt_with_default "PostgreSQL 数据库名 (DB_DATABASE)" "$(current_db_value database)")"
  database="${database:-forest}"
  username="$(prompt_with_default "PostgreSQL 用户名 (DB_USERNAME)" "$(current_db_value username)")"
  username="${username:-postgres}"
  password="$(prompt_secret_with_default "PostgreSQL 密码 (DB_PASSWORD)" "$(current_db_value password)")"
  sslmode="$(prompt_with_default "PostgreSQL SSL 模式 (DB_SSLMODE)" "$(current_db_value sslmode)")"
  sslmode="${sslmode:-disable}"
  dsn="$(build_postgres_dsn_value "${host}" "${port}" "${database}" "${username}" "${password}" "${sslmode}")"

  set_env_var "DB_HOST" "${host}"
  set_env_var "DB_PORT" "${port}"
  set_env_var "DB_DATABASE" "${database}"
  set_env_var "DB_USERNAME" "${username}"
  set_env_var "DB_PASSWORD" "${password}"
  set_env_var "DB_SSLMODE" "${sslmode}"
  set_env_var "POSTGRES_DSN" "${dsn}"

  printf '已更新 PostgreSQL 配置文件：%s\n' "$(resolve_env_path)"
}

ensure_app_key() {
  load_env
  if [[ -z "${APP_KEY:-}" ]]; then
    local generated
    generated="$(cd "${GO_DIR}" && "${GO_BIN}" run ./cmd/ops gen-app-key)"
    set_env_var "APP_KEY" "${generated}"
    export APP_KEY="${generated}"
  fi
}

resolve_postgres_dsn() {
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    return 0
  fi

  local host="${DB_HOST:-127.0.0.1}"
  local port="${DB_PORT:-5432}"
  local database="${DB_DATABASE:-}"
  local username="${DB_USERNAME:-}"
  local password="${DB_PASSWORD:-}"
  local sslmode="${DB_SSLMODE:-disable}"

  if [[ -z "${database}" || -z "${username}" ]]; then
    echo "未配置 PostgreSQL 连接，请设置 POSTGRES_DSN 或 DB_DATABASE/DB_USERNAME"
    exit 1
  fi

  if [[ -n "${password}" ]]; then
    export POSTGRES_DSN="host=${host} port=${port} user=${username} dbname=${database} sslmode=${sslmode} password=${password}"
  else
    export POSTGRES_DSN="host=${host} port=${port} user=${username} dbname=${database} sslmode=${sslmode}"
  fi
}

path_from_go_dir() {
  local path="$1"
  if [[ "${path}" == "${ROOT_DIR}/"* ]]; then
    printf '..%s\n' "${path#${ROOT_DIR}}"
    return 0
  fi
  printf '%s\n' "${path}"
}

resolve_realpath() {
  local current="$1"
  if [[ ! -e "${current}" && ! -L "${current}" ]]; then
    return 1
  fi

  while [[ -L "${current}" ]]; do
    local dir target
    dir="$(cd -P "$(dirname "${current}")" && pwd)"
    target="$(readlink "${current}")"
    if [[ "${target}" != /* ]]; then
      current="${dir}/${target}"
    else
      current="${target}"
    fi
  done

  (
    cd -P "$(dirname "${current}")"
    printf '%s/%s\n' "$(pwd)" "$(basename "${current}")"
  )
}

detect_postgres_server_conf() {
  if [[ -n "${POSTGRES_SERVER_CONF:-}" ]] && [[ -f "${POSTGRES_SERVER_CONF}" ]]; then
    printf '%s\n' "${POSTGRES_SERVER_CONF}"
    return 0
  fi

  local candidate="/www/server/pgsql/data/postgresql.conf"
  if [[ -f "${candidate}" ]]; then
    printf '%s\n' "${candidate}"
    return 0
  fi

  return 1
}

read_postgres_server_conf_value() {
  local conf_path="$1"
  local key="$2"

  awk -v target="${key}" '
    /^[[:space:]]*#/ { next }
    {
      line = $0
      if (line ~ "^[[:space:]]*" target "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        sub(/[[:space:]]*(#.*)?$/, "", line)
        gsub(/^'\''|'\''$/, "", line)
        print line
        exit
      }
    }
  ' "${conf_path}"
}

run_ops_migrate_config() {
  ensure_go
  local args=(run ./cmd/ops migrate-config --target-root ..)
  if [[ -n "${LEGACY_CONFIG_ROOT:-}" ]]; then
    args+=(--legacy-root "$(path_from_go_dir "${LEGACY_CONFIG_ROOT}")")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

build() {
  ensure_go
  cd "${GO_DIR}"
  GOPROXY="${GOPROXY:-https://goproxy.cn,direct}" "${GO_BIN}" mod tidy
  "${GO_BIN}" build -o "${BIN_PATH}" ./cmd/server
}

systemctl_available() {
  if [[ "${SYSTEMCTL_BIN}" == */* ]]; then
    [[ -x "${SYSTEMCTL_BIN}" ]]
    return
  fi
  command -v "${SYSTEMCTL_BIN}" >/dev/null 2>&1
}

pgrep_available() {
  if [[ "${PGREP_BIN}" == */* ]]; then
    [[ -x "${PGREP_BIN}" ]]
    return
  fi
  command -v "${PGREP_BIN}" >/dev/null 2>&1
}

run_pgrep_checked() {
  pgrep_available || return 1
  "${PGREP_BIN}" "$@"
}

run_systemctl_checked() {
  systemctl_available || return 1
  "${SYSTEMCTL_BIN}" "$@"
}

current_systemd_service_managed() {
  systemctl_available || return 1
  [[ -e "${FOREST_SERVICE_FILE_PATH}" ]]
}

legacy_systemd_service_supported() {
  [[ -n "${LEGACY_FOREST_SERVICE_NAME}" ]] || return 1
  [[ "${LEGACY_FOREST_SERVICE_NAME}" != "${FOREST_SERVICE_NAME}" ]]
}

legacy_systemd_service_managed() {
  systemctl_available || return 1
  legacy_systemd_service_supported || return 1
  [[ -e "${LEGACY_FOREST_SERVICE_FILE_PATH}" ]]
}

current_systemd_service_active() {
  current_systemd_service_managed || return 1
  "${SYSTEMCTL_BIN}" is-active --quiet "${FOREST_SERVICE_NAME}" >/dev/null 2>&1
}

legacy_systemd_service_active() {
  legacy_systemd_service_managed || return 1
  "${SYSTEMCTL_BIN}" is-active --quiet "${LEGACY_FOREST_SERVICE_NAME}" >/dev/null 2>&1
}

systemd_service_managed() {
  current_systemd_service_managed && return 0
  legacy_systemd_service_managed
}

active_systemd_service_name() {
  if current_systemd_service_active; then
    printf '%s\n' "${FOREST_SERVICE_NAME}"
    return 0
  fi
  if legacy_systemd_service_active; then
    printf '%s\n' "${LEGACY_FOREST_SERVICE_NAME}"
    return 0
  fi
  return 1
}

systemd_service_active() {
  active_systemd_service_name >/dev/null 2>&1
}

systemd_service_main_pid_for_name() {
  local service_name="$1"
  local pid
  pid="$("${SYSTEMCTL_BIN}" show -p MainPID --value "${service_name}" 2>/dev/null || true)"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  [[ "${pid}" != "0" ]] || return 1
  printf '%s\n' "${pid}"
}

systemd_service_pid() {
  local service_name
  service_name="$(active_systemd_service_name || true)"
  [[ -n "${service_name}" ]] || return 1
  systemd_service_main_pid_for_name "${service_name}"
}

systemd_service_main_pid() {
  systemd_service_main_pid_for_name "${FOREST_SERVICE_NAME}"
}

pid_file_service_pid() {
  [[ -f "${PID_PATH}" ]] || return 1
  local pid
  pid="$(cat "${PID_PATH}")"
  [[ -n "${pid}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  printf '%s\n' "${pid}"
}

process_scan_service_pid() {
  pgrep_available || return 1

  local pattern resolved
  resolved="$(resolve_realpath "${BIN_PATH}" 2>/dev/null || true)"
  pattern="${resolved:-${BIN_PATH}}"

  local matches pid
  matches="$(run_pgrep_checked -f "${pattern}" 2>/dev/null || true)"
  [[ -n "${matches}" ]] || return 1

  while IFS= read -r pid; do
    [[ "${pid}" =~ ^[0-9]+$ ]] || continue
    [[ "${pid}" != "$$" ]] || continue
    [[ "${pid}" != "${PPID:-}" ]] || continue
    kill -0 "${pid}" 2>/dev/null || continue
    printf '%s\n' "${pid}"
    return 0
  done <<< "${matches}"

  return 1
}

current_service_pid() {
  pid_file_service_pid && return 0
  systemd_service_pid && return 0
  process_scan_service_pid
}

write_systemd_service_file() {
  local service_dir tmp
  service_dir="$(dirname "${FOREST_SERVICE_FILE_PATH}")"
  mkdir -p "${service_dir}"
  tmp="${FOREST_SERVICE_FILE_PATH}.tmp.$$"
  cmd_service_template > "${tmp}"
  chmod 0644 "${tmp}" 2>/dev/null || true
  mv "${tmp}" "${FOREST_SERVICE_FILE_PATH}"
}

install_or_refresh_systemd_service() {
  systemctl_available || return 1
  if ! write_systemd_service_file; then
    return 1
  fi
  if ! run_systemctl_checked daemon-reload >/dev/null; then
    return 1
  fi
  return 0
}

migrate_legacy_systemd_service() {
  legacy_systemd_service_supported || return 0

  local migrated=false

  if legacy_systemd_service_active; then
    if ! run_systemctl_checked stop "${LEGACY_FOREST_SERVICE_NAME}" >/dev/null; then
      return 1
    fi
    migrated=true
  fi

  if legacy_systemd_service_managed; then
    run_systemctl_safe disable --now "${LEGACY_FOREST_SERVICE_NAME}"
    rm -f "${LEGACY_FOREST_SERVICE_FILE_PATH}"
    migrated=true
  fi

  if [[ "${migrated}" == "true" ]]; then
    if ! run_systemctl_checked daemon-reload >/dev/null; then
      return 1
    fi
  fi

  return 0
}

ensure_systemd_service_running() {
  if ! migrate_legacy_systemd_service; then
    return 1
  fi
  if ! install_or_refresh_systemd_service; then
    return 1
  fi

  if current_systemd_service_active; then
    if ! run_systemctl_checked restart "${FOREST_SERVICE_NAME}" >/dev/null; then
      return 1
    fi
    local restart_pid
    restart_pid="$(systemd_service_main_pid_for_name "${FOREST_SERVICE_NAME}" || true)"
    if [[ -n "${restart_pid}" ]]; then
      echo "检测到 systemd 服务正在运行，已自动重启，PID ${restart_pid}"
    else
      echo "检测到 systemd 服务正在运行，已自动重启"
    fi
    return 0
  fi

  if ! run_systemctl_checked enable --now "${FOREST_SERVICE_NAME}" >/dev/null; then
    return 1
  fi
  local enabled_pid
  enabled_pid="$(systemd_service_main_pid_for_name "${FOREST_SERVICE_NAME}" || true)"
  if [[ -n "${enabled_pid}" ]]; then
    echo "已通过 systemd 启动并设置开机自启，PID ${enabled_pid}"
  else
    echo "已通过 systemd 启动并设置开机自启"
  fi
  return 0
}

start_binary() {
  cd "${GO_DIR}"
  nohup "${BIN_PATH}" >> "${LOG_PATH}" 2>&1 &
  echo $! > "${PID_PATH}"
}

wait_for_pid_exit() {
  local pid="$1"
  local attempts="${2:-20}"
  local i=0
  while (( i < attempts )); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

stop_local_process_pid() {
  local pid="$1"
  kill "${pid}" 2>/dev/null || true
  if wait_for_pid_exit "${pid}" 20; then
    return 0
  fi
  kill -9 "${pid}" 2>/dev/null || true
  wait_for_pid_exit "${pid}" 10 || true
}

restart_running_service_after_update() {
  local previous_pid="${1:-}"
  if systemd_service_active; then
    run_systemctl_checked restart "${FOREST_SERVICE_NAME}" >/dev/null
    return 0
  fi

  local old_pid current_pid
  old_pid="${previous_pid}"
  if [[ -z "${old_pid}" ]]; then
    old_pid="$(pid_file_service_pid || process_scan_service_pid || true)"
  fi
  if [[ -z "${old_pid}" ]]; then
    return 1
  fi

  current_pid="$(pid_file_service_pid || process_scan_service_pid || true)"
  if [[ -n "${current_pid}" ]]; then
    cmd_stop >/dev/null
  else
    rm -f "${PID_PATH}"
  fi
  start_binary
  return 0
}

warn_if_service_stopped_after_update() {
  print_update_summary stopped
}

run_ops_install() {
  local args=(run ./cmd/ops install --sql ../database/install.pgsql.sql --admin-email "${ADMIN_EMAIL}")
  if [[ -n "${ADMIN_PASSWORD:-}" ]]; then
    args+=(--admin-password "${ADMIN_PASSWORD}")
  fi
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

run_ops_update() {
  local args=(run ./cmd/ops update --sql ../database/update.pgsql.sql)
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

run_ops_migrate_mysql() {
  local source_env="$1"
  local reset_target="${2:-false}"
  local args=(
    run ./cmd/ops migrate-mysql
    --source-env "$(path_from_go_dir "${source_env}")"
    --install-sql ../database/install.pgsql.sql
  )
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--target-dsn "${POSTGRES_DSN}")
  fi
  if [[ "${reset_target}" == "true" ]]; then
    args+=(--reset-target)
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

run_ops_inspect_merge_mysql() {
  local source_host="$1"
  local source_port="$2"
  local source_database="$3"
  local source_username="$4"
  local source_password="$5"
  local source_charset="$6"
  local args=(
    run ./cmd/ops inspect-merge-mysql
    --source-host "${source_host}"
    --source-port "${source_port}"
    --source-database "${source_database}"
    --source-username "${source_username}"
    --source-password "${source_password}"
    --source-charset "${source_charset}"
  )
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--target-dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

run_ops_merge_mysql() {
  local source_host="$1"
  local source_port="$2"
  local source_database="$3"
  local source_username="$4"
  local source_password="$5"
  local source_charset="$6"
  local plan_map="$7"
  local args=(
    run ./cmd/ops merge-mysql
    --source-host "${source_host}"
    --source-port "${source_port}"
    --source-database "${source_database}"
    --source-username "${source_username}"
    --source-password "${source_password}"
    --source-charset "${source_charset}"
    --plan-map "${plan_map}"
  )
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--target-dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

ensure_postgres_target_for_legacy_mysql() {
  local legacy_env
  legacy_env="$(legacy_mysql_env_path)"
  [[ -n "${legacy_env}" ]] || return 1
  ensure_postgres_target_for_legacy_source "${legacy_env}"
}

ensure_postgres_target_for_legacy_source() {
  local legacy_env="$1"
  if db_configured; then
    return 0
  fi
  if ! env_file_looks_legacy_stack "${legacy_env}"; then
    return 1
  fi
  if should_prompt_db_config; then
    echo "检测到旧版 MySQL 环境，请先配置 PostgreSQL 目标库" >&2
    cmd_prompt_db
    load_env
  fi
  if ! db_configured; then
    echo "检测到旧版 MySQL 环境，但 PostgreSQL 目标库尚未配置" >&2
    echo "请运行 ./scripts/appctl prompt-db，或在 .env.go 中设置 POSTGRES_DSN/DB_*" >&2
    exit 1
  fi
}

run_legacy_mysql_migration_flow() {
  local source_env="$1"
  local output=""

  output="$(run_ops_migrate_mysql "${source_env}")"
  if [[ -n "${output}" ]]; then
    printf '%s\n' "${output}"
  fi
  if [[ "${output}" == *"migration_status=applied"* ]]; then
    return 0
  fi
  if [[ "${output}" == *"migration_reason=target_not_empty"* ]]; then
    echo "PostgreSQL 目标库不是空库，已跳过 MySQL 数据导入，继续执行 PostgreSQL 结构更新"
    if should_prompt_db_config && confirm_reset_postgres_target; then
      echo "已确认清空 PostgreSQL 目标库，开始按 MySQL 全量覆盖"
      output="$(run_ops_migrate_mysql "${source_env}" "true")"
      if [[ -n "${output}" ]]; then
        printf '%s\n' "${output}"
      fi
      if [[ "${output}" == *"migration_status=applied"* ]]; then
        return 0
      fi
    fi
  fi
  return 1
}

auto_migrate_legacy_mysql_if_needed() {
  if ! legacy_mysql_configured; then
    return 1
  fi

  echo "已检测到本地旧版 .env 文件，将从 .env 读取 MySQL 源库配置"
  if ! confirm_migrate_legacy_mysql; then
    if ! db_configured && should_prompt_db_config; then
      ensure_postgres_target_for_legacy_mysql
      load_env
    fi
    return 1
  fi
  ensure_postgres_target_for_legacy_mysql
  resolve_postgres_dsn

  local source_env output
  source_env="$(legacy_mysql_env_path)"
  if mysql_force_overwrite_enabled; then
    echo "已启用 FORCE_MYSQL_OVERWRITE=1，开始清空 PostgreSQL 目标库并按 MySQL 全量覆盖"
    output="$(run_ops_migrate_mysql "${source_env}" "true")"
    if [[ -n "${output}" ]]; then
      printf '%s\n' "${output}"
    fi
    if [[ "${output}" == *"migration_status=applied"* ]]; then
      return 0
    fi
    return 1
  fi

  run_legacy_mysql_migration_flow "${source_env}"
}

cmd_install() {
  ensure_go
  cleanup_legacy_runtime_artifacts true
  ensure_app_key
  load_env
  run_ops_migrate_config
  resolve_postgres_dsn
  if [[ -z "${ADMIN_EMAIL:-}" ]]; then
    echo "必须设置 ADMIN_EMAIL"
    exit 1
  fi
  run_ops_install
  build
  ensure_systemd_service_running || {
    start_binary
    echo "已启动，PID $(cat "${PID_PATH}")"
  }
}

cmd_install_legacy() {
  local legacy_input="${1:-}"
  local legacy_root legacy_env env_path env_existed=false

  legacy_root="$(legacy_mysql_root_from_input "${legacy_input}")"
  legacy_env="$(legacy_mysql_env_path_from_root "${legacy_root}")"
  if [[ -z "${legacy_env}" ]]; then
    echo "未在 ${legacy_root} 检测到可用的旧版 MySQL .env" >&2
    exit 1
  fi

  ensure_go
  cleanup_legacy_runtime_artifacts true
  env_path="$(resolve_env_path)"
  if [[ -f "${env_path}" ]]; then
    env_existed=true
  fi
  ensure_env_file
  copy_shared_env_from_legacy_env "${env_path}" "${legacy_env}"
  ensure_app_key
  load_env

  export LEGACY_CONFIG_ROOT="${legacy_root}"
  run_ops_migrate_config
  unset LEGACY_CONFIG_ROOT

  if [[ "${env_existed}" != "true" && -z "${POSTGRES_DSN:-}" && should_prompt_db_config ]]; then
    cmd_prompt_db
    load_env
  fi
  ensure_postgres_target_for_legacy_source "${legacy_env}"
  resolve_postgres_dsn
  if ! run_legacy_mysql_migration_flow "${legacy_env}"; then
    exit 1
  fi
  build
  ensure_systemd_service_running || {
    start_binary
    echo "已启动，PID $(cat "${PID_PATH}")"
  }
}

cmd_update() {
  local previous_pid=""
  local had_running_service=false
  if ! systemd_service_active; then
    previous_pid="$(pid_file_service_pid || process_scan_service_pid || true)"
  else
    had_running_service=true
  fi
  if [[ -n "${previous_pid}" ]]; then
    had_running_service=true
  fi

  print_update_step "1/5" "拉取最新代码"
  update_source_code_from_git

  print_update_step "2/5" "检查运行环境"
  ensure_go
  cleanup_legacy_runtime_artifacts true
  load_env

  print_update_step "3/5" "同步运行配置"
  run_ops_migrate_config

  print_update_step "4/5" "执行数据库更新"
  if auto_migrate_legacy_mysql_if_needed; then
    print_update_step "5/5" "构建并应用更新"
    build
    if ensure_systemd_service_running >/dev/null; then
      if [[ "${had_running_service}" == "true" ]]; then
        print_update_summary restarted
      else
        print_update_summary started
      fi
      return 0
    fi
    if restart_running_service_after_update "${previous_pid}" >/dev/null; then
      print_update_summary restarted
    else
      warn_if_service_stopped_after_update
    fi
    return 0
  fi
  resolve_postgres_dsn
  run_ops_update

  print_update_step "5/5" "构建并应用更新"
  build
  if ensure_systemd_service_running >/dev/null; then
    if [[ "${had_running_service}" == "true" ]]; then
      print_update_summary restarted
    else
      print_update_summary started
    fi
    return 0
  fi
  if restart_running_service_after_update "${previous_pid}" >/dev/null; then
    print_update_summary restarted
  else
    warn_if_service_stopped_after_update
  fi
}

cmd_start() {
  cleanup_legacy_runtime_artifacts true
  load_env
  run_ops_migrate_config
  resolve_postgres_dsn
  if current_service_pid >/dev/null; then
    echo "Go API 已在运行"
    return 0
  fi
  build
  if ensure_systemd_service_running; then
    return 0
  fi
  start_binary
  echo "已启动，PID $(cat "${PID_PATH}")"
}

cmd_run() {
  cleanup_legacy_runtime_artifacts true
  load_env
  run_ops_migrate_config
  resolve_postgres_dsn
  build
  cd "${GO_DIR}"
  exec "${BIN_PATH}"
}

cmd_stop() {
  local systemd_name=""
  systemd_name="$(active_systemd_service_name || true)"
  if [[ -n "${systemd_name}" ]]; then
    run_systemctl_checked stop "${systemd_name}" >/dev/null
    rm -f "${PID_PATH}"
    echo "已停止（systemd）"
    return 0
  fi

  local pid
  pid="$(pid_file_service_pid || process_scan_service_pid || true)"
  if [[ -z "${pid}" ]]; then
    rm -f "${PID_PATH}"
    echo "Go API 未运行"
    return 0
  fi
  stop_local_process_pid "${pid}"
  rm -f "${PID_PATH}"
  echo "已停止"
}

cmd_status() {
  local pid
  if pid="$(systemd_service_pid || true)" && [[ -n "${pid}" ]]; then
    echo "运行中，PID ${pid}（systemd）"
    return 0
  fi
  if pid="$(pid_file_service_pid || true)" && [[ -n "${pid}" ]]; then
    echo "运行中，PID $(cat "${PID_PATH}")"
    return 0
  fi
  if pid="$(process_scan_service_pid || true)" && [[ -n "${pid}" ]]; then
    echo "运行中，PID ${pid}（进程扫描）"
    return 0
  fi
  echo "已停止"
}

cmd_test() {
  ensure_go
  cd "${GO_DIR}"
  GOPROXY="${GOPROXY:-https://goproxy.cn,direct}" "${GO_BIN}" test ./...
}

cmd_init_env() {
  local env_path
  env_path="$(resolve_env_path)"
  if [[ -f "${env_path}" ]]; then
    echo "${env_path} 已存在，无需重复初始化"
    return 0
  fi
  cp "$(resolve_env_example_path)" "${env_path}"
  if [[ "${env_path}" == "${ROOT_DIR}/.env.go" ]]; then
    copy_shared_env_from_legacy_stack "${env_path}"
  fi
  echo "已初始化 ${env_path}"
}

cmd_doctor() {
  local env_path legacy_env env_exists legacy_ignored
  env_path="$(resolve_env_path)"
  legacy_env="${ROOT_DIR}/.env"
  env_exists=false
  legacy_ignored=false

  if [[ -f "${env_path}" ]]; then
    env_exists=true
    load_env_from_path "${env_path}"
  fi
  if [[ "${env_path}" == "${ROOT_DIR}/.env.go" ]] && env_file_looks_legacy_stack "${legacy_env}"; then
    legacy_ignored=true
  fi

  local postgres_configured=false
  if [[ -n "${POSTGRES_DSN:-}" ]] || { [[ -n "${DB_DATABASE:-}" ]] && [[ -n "${DB_USERNAME:-}" ]]; }; then
    postgres_configured=true
  fi

  local admin_email_configured=false
  if [[ -n "${ADMIN_EMAIL:-}" ]]; then
    admin_email_configured=true
  fi

  local postgres_server_conf="not_found"
  local postgres_server_log_statement="unknown"
  local postgres_server_log_min_duration_statement="unknown"
  if postgres_server_conf="$(detect_postgres_server_conf 2>/dev/null)"; then
    postgres_server_log_statement="$(read_postgres_server_conf_value "${postgres_server_conf}" "log_statement")"
    postgres_server_log_min_duration_statement="$(read_postgres_server_conf_value "${postgres_server_conf}" "log_min_duration_statement")"
    postgres_server_log_statement="${postgres_server_log_statement:-unknown}"
    postgres_server_log_min_duration_statement="${postgres_server_log_min_duration_statement:-unknown}"
  else
    postgres_server_conf="not_found"
  fi

  printf 'env_file=%s\n' "${env_path}"
  printf 'env_exists=%s\n' "${env_exists}"
  printf 'legacy_env_ignored=%s\n' "${legacy_ignored}"
  printf 'postgres_configured=%s\n' "${postgres_configured}"
  printf 'admin_email_configured=%s\n' "${admin_email_configured}"
  printf 'postgres_server_conf=%s\n' "${postgres_server_conf}"
  printf 'postgres_server_log_statement=%s\n' "${postgres_server_log_statement}"
  printf 'postgres_server_log_min_duration_statement=%s\n' "${postgres_server_log_min_duration_statement}"
  if [[ "${postgres_server_log_statement}" == "all" ]]; then
    printf 'postgres_server_log_warning=%s\n' "检测到 PostgreSQL 正在记录全部 SQL，日志会迅速膨胀，建议改成 none 或 ddl"
  fi
}

cmd_migrate_config() {
  ensure_go
  if [[ $# -gt 0 ]] && [[ -n "${1:-}" ]]; then
    export LEGACY_CONFIG_ROOT="$1"
  fi
  run_ops_migrate_config
}

cmd_migrate_mysql() {
  ensure_go
  load_env
  run_ops_migrate_config
  if ! legacy_mysql_configured; then
    echo "未检测到旧版 MySQL 环境"
    exit 1
  fi
  ensure_postgres_target_for_legacy_mysql
  resolve_postgres_dsn

  local source_env output
  source_env="$(legacy_mysql_env_path)"
  if mysql_force_overwrite_enabled; then
    echo "已启用 FORCE_MYSQL_OVERWRITE=1，开始清空 PostgreSQL 目标库并按 MySQL 全量覆盖"
    output="$(run_ops_migrate_mysql "${source_env}" "true")"
    if [[ -n "${output}" ]]; then
      printf '%s\n' "${output}"
    fi
    return 0
  fi

  output="$(run_ops_migrate_mysql "${source_env}")"
  if [[ -n "${output}" ]]; then
    printf '%s\n' "${output}"
  fi
}

cmd_merge_mysql() {
  ensure_go
  load_env
  resolve_merge_mysql_postgres_dsn

  local merge_profile_path=""
  merge_profile_path="$(merge_mysql_profile_path || true)"
  if [[ -n "${merge_profile_path}" ]]; then
    echo "已加载 MySQL 合并预设: ${merge_profile_path}"
  fi

  local source_host source_port source_database source_username source_password source_charset
  local source_host_default source_port_default source_database_default source_username_default source_password_default source_charset_default
  source_host_default="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_HOST" "DB_HOST" "127.0.0.1")"
  source_port_default="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_PORT" "DB_PORT" "3306")"
  source_database_default="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_DATABASE" "DB_DATABASE")"
  source_username_default="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_USERNAME" "DB_USERNAME")"
  source_password_default="$(merge_mysql_profile_value "MERGE_MYSQL_SOURCE_PASSWORD" "$(legacy_mysql_default_value "DB_PASSWORD")")"
  source_charset_default="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_CHARSET" "DB_CHARSET" "utf8mb4")"

  if merge_mysql_source_preset_ready; then
    source_host="${source_host_default:-127.0.0.1}"
    source_port="${source_port_default:-3306}"
    source_database="${source_database_default}"
    source_username="${source_username_default}"
    source_password="${source_password_default}"
    source_charset="${source_charset_default:-utf8mb4}"
  else
    source_host="$(prompt_with_default "源 MySQL 主机" "${source_host_default}")"
    source_host="${source_host:-127.0.0.1}"
    source_port="$(prompt_with_default "源 MySQL 端口" "${source_port_default}")"
    source_port="${source_port:-3306}"
    source_database="$(prompt_with_default "源 MySQL 数据库名" "${source_database_default}")"
    source_username="$(prompt_with_default "源 MySQL 用户名" "${source_username_default}")"
    source_password="$(prompt_secret_with_default "源 MySQL 密码" "${source_password_default}")"
    source_charset="$(prompt_with_default "源 MySQL 字符集" "${source_charset_default}")"
    source_charset="${source_charset:-utf8mb4}"
  fi

  if [[ -z "${source_database}" || -z "${source_username}" ]]; then
    echo "源 MySQL 数据库名和用户名不能为空"
    exit 1
  fi

  local inspect_output
  inspect_output="$(run_ops_inspect_merge_mysql "${source_host}" "${source_port}" "${source_database}" "${source_username}" "${source_password}" "${source_charset}")"

  local source_users_total="0"
  local source_users_without_plan="0"
  local -a source_plans=()
  local -a target_plans=()
  local line kind plan_id plan_name plan_users
  while IFS= read -r line; do
    case "${line}" in
      source_users_total=*)
        source_users_total="${line#*=}"
        ;;
      source_users_without_plan=*)
        source_users_without_plan="${line#*=}"
        ;;
      $'source_plan\t'*)
        IFS=$'\t' read -r kind plan_id plan_name plan_users <<< "${line}"
        source_plans+=("${plan_id}"$'\t'"${plan_name}"$'\t'"${plan_users}")
        ;;
      $'target_plan\t'*)
        IFS=$'\t' read -r kind plan_id plan_name plan_users <<< "${line}"
        target_plans+=("${plan_id}"$'\t'"${plan_name}"$'\t'"${plan_users}")
        ;;
    esac
  done <<< "${inspect_output}"

  echo "源库用户总数: ${source_users_total}"
  echo "无套餐用户数: ${source_users_without_plan}"
  echo

  if [[ ${#source_plans[@]} -gt 0 ]]; then
    echo "检测到旧套餐："
    local item source_plan_id source_plan_name source_plan_count
    for item in "${source_plans[@]}"; do
      IFS=$'\t' read -r source_plan_id source_plan_name source_plan_count <<< "${item}"
      [[ -n "${source_plan_name}" ]] || source_plan_name="未命名套餐"
      printf '  [%s] %s（用户 %s）\n' "${source_plan_id}" "${source_plan_name}" "${source_plan_count}"
    done
    echo
  else
    echo "源库没有检测到已绑定套餐的用户"
    echo
  fi

  if [[ ${#target_plans[@]} -gt 0 ]]; then
    echo "当前站可用套餐："
    local target_item target_id target_name target_user_count
    for target_item in "${target_plans[@]}"; do
      IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
      [[ -n "${target_name}" ]] || target_name="未命名套餐"
      printf '  [%s] %s（当前用户 %s）\n' "${target_id}" "${target_name}" "${target_user_count}"
    done
    echo
  fi

  if [[ ${#source_plans[@]} -gt 0 && ${#target_plans[@]} -eq 0 ]]; then
    echo "目标站没有可用套餐，请先在当前站创建套餐后再合并"
    exit 1
  fi

  local -a plan_map_entries=()
  local saved_plan_map=""
  saved_plan_map="$(merge_mysql_profile_value "MERGE_MYSQL_PLAN_MAP")"
  local mapping_input resolved_target_id
  local source_item source_plan_id source_plan_name source_plan_count
  for source_item in "${source_plans[@]}"; do
    IFS=$'\t' read -r source_plan_id source_plan_name source_plan_count <<< "${source_item}"
    [[ -n "${source_plan_name}" ]] || source_plan_name="未命名套餐"

    local saved_mapping_input=""
    saved_mapping_input="$(merge_mysql_plan_map_lookup "${saved_plan_map}" "${source_plan_id}" || true)"
    resolved_target_id=""
    if [[ -n "${saved_mapping_input}" ]]; then
      local target_item target_id target_name target_user_count
      if [[ "${saved_mapping_input}" =~ ^[0-9]+$ ]]; then
        for target_item in "${target_plans[@]}"; do
          IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
          if [[ "${saved_mapping_input}" == "${target_id}" ]]; then
            resolved_target_id="${target_id}"
            break
          fi
        done
      else
        for target_item in "${target_plans[@]}"; do
          IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
          if [[ "${saved_mapping_input}" == "${target_name}" ]]; then
            resolved_target_id="${target_id}"
            break
          fi
        done
      fi
      if [[ -n "${resolved_target_id}" ]]; then
        plan_map_entries+=("${source_plan_id}:${resolved_target_id}")
        continue
      fi
    fi

    while true; do
      mapping_input="$(prompt_with_default "旧套餐 [${source_plan_id}] ${source_plan_name}（用户 ${source_plan_count}） -> 新套餐 ID 或完整名称（留空=跳过）" "${saved_mapping_input}")"
      mapping_input="$(printf '%s' "${mapping_input}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
      if [[ -z "${mapping_input}" ]]; then
        break
      fi

      resolved_target_id=""
      local target_item target_id target_name target_user_count
      if [[ "${mapping_input}" =~ ^[0-9]+$ ]]; then
        for target_item in "${target_plans[@]}"; do
          IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
          if [[ "${mapping_input}" == "${target_id}" ]]; then
            resolved_target_id="${target_id}"
            break
          fi
        done
      else
        for target_item in "${target_plans[@]}"; do
          IFS=$'\t' read -r target_id target_name target_user_count <<< "${target_item}"
          if [[ "${mapping_input}" == "${target_name}" ]]; then
            resolved_target_id="${target_id}"
            break
          fi
        done
      fi

      if [[ -n "${resolved_target_id}" ]]; then
        plan_map_entries+=("${source_plan_id}:${resolved_target_id}")
        break
      fi
      echo "未找到对应的新套餐，请输入列表里的套餐 ID 或完整名称"
    done
  done

  local plan_map=""
  if [[ ${#plan_map_entries[@]} -gt 0 ]]; then
    plan_map="$(IFS=,; printf '%s' "${plan_map_entries[*]}")"
  fi

  echo "即将开始合并 MySQL 用户库："
  echo "  源库: ${source_host}:${source_port}/${source_database}"
  echo "  目标库: 当前 PostgreSQL 站点"
  echo "  套餐映射数: ${#plan_map_entries[@]}"
  if [[ "${source_users_without_plan}" != "0" ]]; then
    echo "  无套餐用户: 保留原用户数据并直接并入"
  fi
  echo "冲突处理规则："
  echo "  同邮箱账号：并入当前站已有账号"
  echo "  当前站密码：不覆盖"
  echo "  当前站套餐：同邮箱时保留更高档套餐"
  echo "  token 冲突：自动生成新值"
  echo "  邀请码冲突：自动改成唯一值"
  echo "  未映射旧套餐用户：跳过"

  local answer=""
  printf '确认开始合并？ [y/N]: ' >&2
  IFS= read -r answer || true
  answer="$(normalize_yes_no_answer "${answer}")"
  if [[ "${answer}" != "y" && "${answer}" != "yes" ]]; then
    echo "已取消合并"
    return 0
  fi

  local merge_output
  merge_output="$(run_ops_merge_mysql "${source_host}" "${source_port}" "${source_database}" "${source_username}" "${source_password}" "${source_charset}" "${plan_map}")"
  if [[ -n "${merge_output}" ]]; then
    printf '%s\n' "${merge_output}"
  fi
}

cmd_merge_mysql_apply() {
  ensure_go
  load_env_if_present

  local merge_profile_path=""
  merge_profile_path="$(merge_mysql_profile_path || true)"
  if [[ -z "${merge_profile_path}" ]]; then
    echo "未找到 MySQL 合并预设，请先创建 /etc/forest/merge-mysql.env 或 .merge-mysql.env"
    exit 1
  fi
  echo "已加载 MySQL 合并预设: ${merge_profile_path}"

  resolve_merge_mysql_postgres_dsn

  local source_host source_port source_database source_username source_password source_charset
  source_host="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_HOST" "DB_HOST" "127.0.0.1")"
  source_host="${source_host:-127.0.0.1}"
  source_port="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_PORT" "DB_PORT" "3306")"
  source_port="${source_port:-3306}"
  source_database="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_DATABASE" "DB_DATABASE")"
  source_username="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_USERNAME" "DB_USERNAME")"
  source_password="$(merge_mysql_profile_value "MERGE_MYSQL_SOURCE_PASSWORD" "$(legacy_mysql_default_value "DB_PASSWORD")")"
  source_charset="$(merge_mysql_source_default_value "MERGE_MYSQL_SOURCE_CHARSET" "DB_CHARSET" "utf8mb4")"
  source_charset="${source_charset:-utf8mb4}"

  if [[ -z "${source_database}" || -z "${source_username}" || -z "${source_password}" ]]; then
    echo "MySQL 合并预设不完整，至少需要 MERGE_MYSQL_SOURCE_DATABASE / MERGE_MYSQL_SOURCE_USERNAME / MERGE_MYSQL_SOURCE_PASSWORD"
    exit 1
  fi

  local inspect_output
  inspect_output="$(run_ops_inspect_merge_mysql "${source_host}" "${source_port}" "${source_database}" "${source_username}" "${source_password}" "${source_charset}")"

  local source_users_total="0"
  local source_users_without_plan="0"
  local -a source_plans=()
  local -a target_plans=()
  local line kind plan_id plan_name plan_users
  while IFS= read -r line; do
    case "${line}" in
      source_users_total=*)
        source_users_total="${line#*=}"
        ;;
      source_users_without_plan=*)
        source_users_without_plan="${line#*=}"
        ;;
      $'source_plan\t'*)
        IFS=$'\t' read -r kind plan_id plan_name plan_users <<< "${line}"
        source_plans+=("${plan_id}"$'\t'"${plan_name}"$'\t'"${plan_users}")
        ;;
      $'target_plan\t'*)
        IFS=$'\t' read -r kind plan_id plan_name plan_users <<< "${line}"
        target_plans+=("${plan_id}"$'\t'"${plan_name}"$'\t'"${plan_users}")
        ;;
    esac
  done <<< "${inspect_output}"

  if [[ ${#source_plans[@]} -gt 0 && ${#target_plans[@]} -eq 0 ]]; then
    echo "目标站没有可用套餐，请先在当前站创建套餐后再合并"
    exit 1
  fi

  local saved_plan_map=""
  saved_plan_map="$(merge_mysql_profile_value "MERGE_MYSQL_PLAN_MAP")"
  local -a plan_map_entries=()
  local -a unresolved_mappings=()
  local source_item source_plan_id source_plan_name source_plan_count saved_mapping_input resolved_target_id
  for source_item in "${source_plans[@]}"; do
    IFS=$'\t' read -r source_plan_id source_plan_name source_plan_count <<< "${source_item}"
    [[ -n "${source_plan_name}" ]] || source_plan_name="未命名套餐"

    saved_mapping_input="$(merge_mysql_plan_map_lookup "${saved_plan_map}" "${source_plan_id}" || true)"
    if [[ -z "${saved_mapping_input}" ]]; then
      unresolved_mappings+=("[${source_plan_id}] ${source_plan_name}")
      continue
    fi

    resolved_target_id="$(resolve_merge_mysql_target_plan_id "${saved_mapping_input}" "${target_plans[@]}" || true)"
    if [[ -z "${resolved_target_id}" ]]; then
      unresolved_mappings+=("[${source_plan_id}] ${source_plan_name} -> ${saved_mapping_input}")
      continue
    fi
    plan_map_entries+=("${source_plan_id}:${resolved_target_id}")
  done

  if [[ ${#unresolved_mappings[@]} -gt 0 ]]; then
    echo "以下旧套餐未完成映射，已中止："
    local unresolved_item
    for unresolved_item in "${unresolved_mappings[@]}"; do
      printf '  %s\n' "${unresolved_item}"
    done
    echo "请在 merge-mysql 预设中填写 MERGE_MYSQL_PLAN_MAP，格式例如：1:12,2:13,3:1"
    exit 1
  fi

  local plan_map=""
  if [[ ${#plan_map_entries[@]} -gt 0 ]]; then
    plan_map="$(IFS=,; printf '%s' "${plan_map_entries[*]}")"
  fi

  echo "使用预设直接执行 MySQL 合并"
  echo "  源库: ${source_host}:${source_port}/${source_database}"
  echo "  目标库: ${POSTGRES_DSN}"
  echo "  源库用户总数: ${source_users_total}"
  echo "  无套餐用户数: ${source_users_without_plan}"
  echo "  套餐映射数: ${#plan_map_entries[@]}"
  echo "  同邮箱账号: 自动并入当前站已有账号"
  echo "  未配置密码/非法邮箱/未映射套餐: 发现即直接报错或跳过统计"

  local merge_output
  merge_output="$(run_ops_merge_mysql "${source_host}" "${source_port}" "${source_database}" "${source_username}" "${source_password}" "${source_charset}" "${plan_map}")"
  if [[ -n "${merge_output}" ]]; then
    printf '%s\n' "${merge_output}"
  fi
}

cmd_merge_mysql_template() {
  cat <<'EOF'
cat > .merge-mysql.env <<'PROFILE'
MERGE_MYSQL_SOURCE_HOST=127.0.0.1
MERGE_MYSQL_SOURCE_PORT=3306
MERGE_MYSQL_SOURCE_DATABASE=legacy_db
MERGE_MYSQL_SOURCE_USERNAME=legacy_user
MERGE_MYSQL_SOURCE_PASSWORD=legacy_pass
MERGE_MYSQL_SOURCE_CHARSET=utf8mb4
MERGE_MYSQL_TARGET_DSN=host=127.0.0.1 port=5432 user=forest_user dbname=forest sslmode=disable password=forest_pass
MERGE_MYSQL_PLAN_MAP=1:12,2:13,3:1
PROFILE

./scripts/appctl merge-mysql-apply
EOF
}

cmd_create_admin() {
  ensure_go
  load_env
  resolve_postgres_dsn
  if [[ -z "${ADMIN_EMAIL:-}" ]]; then
    echo "必须设置 ADMIN_EMAIL"
    exit 1
  fi

  local args=(run ./cmd/ops create-admin --admin-email "${ADMIN_EMAIL}")
  if [[ -n "${ADMIN_PASSWORD:-}" ]]; then
    args+=(--admin-password "${ADMIN_PASSWORD}")
  fi
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

cmd_seed_demo() {
  ensure_go
  load_env
  resolve_postgres_dsn

  local args=(run ./cmd/ops seed-demo)
  if [[ -n "${ADMIN_EMAIL:-}" ]]; then
    args+=(--admin-email "${ADMIN_EMAIL}")
  fi
  if [[ -n "${ADMIN_PASSWORD:-}" ]]; then
    args+=(--admin-password "${ADMIN_PASSWORD}")
  fi
  if [[ -n "${POSTGRES_DSN:-}" ]]; then
    args+=(--dsn "${POSTGRES_DSN}")
  fi
  cd "${GO_DIR}"
  "${GO_BIN}" "${args[@]}"
}

cmd_env_file() {
  printf '%s\n' "$(resolve_env_path)"
}

cmd_service_template() {
  local env_path
  env_path="$(resolve_env_path)"
  cat <<EOF
[Unit]
Description=forest
After=network.target

[Service]
Type=simple
WorkingDirectory=${ROOT_DIR}
EnvironmentFile=-${env_path}
ExecStart=${ROOT_DIR}/scripts/appctl run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
}

default_link_target_dir() {
  if [[ -n "${FOREST_LINK_DIR:-}" ]]; then
    printf '%s\n' "${FOREST_LINK_DIR}"
    return 0
  fi
  if [[ -d "/usr/local/bin" && -w "/usr/local/bin" ]]; then
    printf '%s\n' "/usr/local/bin"
    return 0
  fi
  if [[ -n "${HOME:-}" ]]; then
    mkdir -p "${HOME}/.local/bin"
    printf '%s\n' "${HOME}/.local/bin"
    return 0
  fi
  echo "无法确定全局命令安装目录，请手动指定目标目录" >&2
  exit 1
}

cmd_install_link() {
  local target_dir="${1:-}"
  if [[ -z "${target_dir}" ]]; then
    target_dir="$(default_link_target_dir)"
  fi

  mkdir -p "${target_dir}"
  local target_path="${target_dir}/forest"
  if [[ -e "${target_path}" && ! -L "${target_path}" ]]; then
    echo "目标已存在且不是软链：${target_path}" >&2
    exit 1
  fi

  ln -sfn "${ROOT_DIR}/menu.sh" "${target_path}"
  echo "已安装全局命令：${target_path} -> ${ROOT_DIR}/menu.sh"
  if [[ ":${PATH}:" != *":${target_dir}:"* ]]; then
    echo "提示：当前 PATH 未包含 ${target_dir}，请手动加入后再直接执行 forest"
  fi
}

run_systemctl_safe() {
  if ! systemctl_available; then
    return 0
  fi
  "${SYSTEMCTL_BIN}" "$@" >/dev/null 2>&1 || true
}

remove_managed_forest_links() {
  local removed=0
  local candidates=()
  local path resolved_target expected_target=""

  expected_target="$(resolve_realpath "${ROOT_DIR}/menu.sh" 2>/dev/null || true)"

  if [[ -n "${FOREST_LINK_PATH:-}" ]]; then
    candidates+=("${FOREST_LINK_PATH}")
  fi
  candidates+=("/usr/local/bin/forest")
  if [[ -n "${HOME:-}" ]]; then
    candidates+=("${HOME}/.local/bin/forest")
  fi

  for path in "${candidates[@]}"; do
    [[ -L "${path}" ]] || continue
    resolved_target="$(resolve_realpath "${path}" 2>/dev/null || true)"
    if [[ -z "${resolved_target}" || -z "${expected_target}" || "${resolved_target}" != "${expected_target}" ]]; then
      continue
    fi
    rm -f "${path}"
    removed=$((removed + 1))
  done

  printf '%s\n' "${removed}"
}

cmd_uninstall() {
  local removed_links=0
  local removed_service=false

  cmd_stop >/dev/null 2>&1 || true
  cleanup_legacy_runtime_artifacts true

  if [[ -e "${FOREST_SERVICE_FILE_PATH}" ]]; then
    run_systemctl_safe disable --now "${FOREST_SERVICE_NAME}"
    rm -f "${FOREST_SERVICE_FILE_PATH}"
    removed_service=true
  fi

  if legacy_systemd_service_managed; then
    run_systemctl_safe disable --now "${LEGACY_FOREST_SERVICE_NAME}"
    rm -f "${LEGACY_FOREST_SERVICE_FILE_PATH}"
    removed_service=true
  fi

  if [[ "${removed_service}" == "true" ]]; then
    run_systemctl_safe daemon-reload
  fi

  removed_links="$(remove_managed_forest_links)"

  echo "已卸载当前部署（保留数据库、环境文件和项目目录）"
  printf '移除 systemd 服务文件: %s\n' "${removed_service}"
  printf '移除全局 forest 命令数量: %s\n' "${removed_links}"
}

cmd_cleanup() {
  cleanup_legacy_runtime_artifacts false
}

usage() {
  cat <<'EOF'
用法：
  ./scripts/appctl install
  ./scripts/appctl install-legacy [legacy-root|legacy-env]
  ./scripts/appctl update
  ./scripts/appctl cleanup
  ./scripts/appctl build
  ./scripts/appctl migrate-config [legacy-config-root]
  ./scripts/appctl migrate-mysql
  ./scripts/appctl merge-mysql
  ./scripts/appctl merge-mysql-apply
  ./scripts/appctl merge-mysql-template
  ./scripts/appctl init-env
  ./scripts/appctl doctor
  ./scripts/appctl run
  ./scripts/appctl start
  ./scripts/appctl stop
  ./scripts/appctl restart
  ./scripts/appctl status
  ./scripts/appctl test
  ./scripts/appctl create-admin
  ./scripts/appctl seed-demo
  ./scripts/appctl env-file
  ./scripts/appctl prompt-db [--optional]
  ./scripts/appctl doctor
  ./scripts/appctl service-template
  ./scripts/appctl install-link [target-dir]
  ./scripts/appctl uninstall

安装时必须设置：
  ADMIN_EMAIL
数据库环境变量：
  优先使用 POSTGRES_DSN
  或 DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD
环境文件优先级：
  .env.go
  .env（仅当它看起来不是旧版 MySQL/Redis 环境时才会使用）
EOF
}

action="${1:-}"
case "${action}" in
  install) cmd_install ;;
  install-legacy) shift; cmd_install_legacy "$@" ;;
  update) cmd_update ;;
  cleanup) cmd_cleanup ;;
  build) build ;;
  migrate-config) shift; cmd_migrate_config "$@" ;;
  migrate-mysql) shift; cmd_migrate_mysql "$@" ;;
  merge-mysql) shift; cmd_merge_mysql "$@" ;;
  merge-mysql-apply) shift; cmd_merge_mysql_apply "$@" ;;
  merge-mysql-template) shift; cmd_merge_mysql_template "$@" ;;
  init-env) cmd_init_env ;;
  doctor) cmd_doctor ;;
  run) cmd_run ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  test) cmd_test ;;
  create-admin) cmd_create_admin ;;
  seed-demo) cmd_seed_demo ;;
  env-file) cmd_env_file ;;
  prompt-db) shift; cmd_prompt_db "$@" ;;
  service-template) cmd_service_template ;;
  install-link) shift; cmd_install_link "$@" ;;
  uninstall) cmd_uninstall ;;
  *) usage; exit 1 ;;
esac
