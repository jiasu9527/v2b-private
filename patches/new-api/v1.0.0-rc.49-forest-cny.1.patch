+// CNYQuotaSnapshot validates a persisted checkout without consulting mutable
+// global pricing options. Rounding is once, to the nearest internal quota unit;
+// the resulting two-decimal CNY amount must still equal the charged amount.
+func (topUp *TopUp) CNYQuotaSnapshot() (int, error) {
+	if topUp == nil || topUp.PaymentProvider != PaymentProviderEpay || topUp.Currency != "CNY" || topUp.Amount != 0 ||
+		topUp.AmountFen < 100 || topUp.AmountFen > common.MaxWalletQuota || topUp.QuotaPerUnit <= 0 || topUp.QuotaPerUnit > common.MaxWalletQuota ||
+		topUp.CreditedQuota <= 0 || topUp.CreditedQuota > common.MaxWalletQuota || len(topUp.QuoteHash) != 64 ||
+		len(topUp.DisplayRate) == 0 || len(topUp.DisplayRate) > 64 || math.IsNaN(topUp.Money) || math.IsInf(topUp.Money, 0) {
+		return 0, ErrInvalidTopUpQuota
+	}
+	if _, err := hex.DecodeString(topUp.QuoteHash); err != nil {
+		return 0, ErrInvalidTopUpQuota
+	}
+	if strings.Count(topUp.DisplayRate, ".") > 1 {
+		return 0, ErrInvalidTopUpQuota
+	}
+	for _, c := range topUp.DisplayRate {
+		if (c < '0' || c > '9') && c != '.' {
+			return 0, ErrInvalidTopUpQuota
+		}
+	}
+	rate, err := decimal.NewFromString(topUp.DisplayRate)
+	if err != nil || !rate.IsPositive() {
+		return 0, ErrInvalidTopUpQuota
+	}
+	fen := decimal.NewFromInt(topUp.AmountFen)
+	unit := decimal.NewFromInt(topUp.QuotaPerUnit)
+	quota := decimal.NewFromInt(topUp.CreditedQuota)
+	if !fen.Mul(unit).DivRound(rate.Mul(decimal.NewFromInt(100)), 0).Equal(quota) ||
+		!quota.Mul(rate).Mul(decimal.NewFromInt(100)).DivRound(unit, 0).Equal(fen) ||
+		!decimal.NewFromFloat(topUp.Money).Equal(fen.Div(decimal.NewFromInt(100))) {
+		return 0, ErrInvalidTopUpQuota
+	}
+	return int(topUp.CreditedQuota), nil
+}
