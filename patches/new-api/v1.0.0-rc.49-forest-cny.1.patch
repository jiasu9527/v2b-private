+func TestCNYSettlementRejectsCorruptSnapshotWithoutCredit(t *testing.T) {
+	for _, manual := range []bool{false, true} {
+		t.Run(fmt.Sprint(manual), func(t *testing.T) {
+			truncateTables(t)
+			user := insertUserForPaymentGuardTest(t, 700, 19)
+			order := cnySnapshotTestOrder(100)
+			require.NoError(t, order.Insert())
+			require.NoError(t, DB.Model(&TopUp{}).Where("id = ?", order.Id).Update("credited_quota", order.CreditedQuota+1).Error)
+			var err error
+			if manual {
+				err = ManualCompleteTopUp(order.TradeNo, "127.0.0.1")
+			} else {
+				_, err = RechargeEpay(order.TradeNo, "alipay", "127.0.0.1")
+			}
+			require.ErrorIs(t, err, ErrInvalidTopUpQuota)
+			assert.Equal(t, 19, getUserQuotaForPaymentGuardTest(t, user.Id))
+			assert.Equal(t, common.TopUpStatusPending, getTopUpStatusForPaymentGuardTest(t, order.TradeNo))
+		})
+	}
+}
