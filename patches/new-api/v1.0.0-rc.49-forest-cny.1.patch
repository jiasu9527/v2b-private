+func TestCNYSettlementHonorsWalletLimit(t *testing.T) {
+	truncateTables(t)
+	order := cnySnapshotTestOrder(100)
+	user := insertUserForPaymentGuardTest(t, 700, common.MaxWalletQuota-int(order.CreditedQuota)+1)
+	require.NoError(t, order.Insert())
+	_, err := RechargeEpay(order.TradeNo, "alipay", "127.0.0.1")
