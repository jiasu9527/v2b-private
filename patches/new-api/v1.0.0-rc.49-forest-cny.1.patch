+func TestCNYQuotaSnapshotRejectsMalformedAndPartialFields(t *testing.T) {
+	tests := map[string]func(*TopUp){
+		"under minimum":           func(o *TopUp) { o.AmountFen = 99 },
+		"missing fen":             func(o *TopUp) { o.AmountFen = 0 },
+		"negative fen":            func(o *TopUp) { o.AmountFen = -100 },
+		"overflow fen":            func(o *TopUp) { o.AmountFen = common.MaxWalletQuota + 1 },
+		"legacy amount populated": func(o *TopUp) { o.Amount = 1 },
+		"foreign provider":        func(o *TopUp) { o.PaymentProvider = PaymentProviderStripe },
+		"missing currency":        func(o *TopUp) { o.Currency = "" },
+		"foreign currency":        func(o *TopUp) { o.Currency = "USD" },
+		"missing quota":           func(o *TopUp) { o.CreditedQuota = 0 },
+		"negative quota":          func(o *TopUp) { o.CreditedQuota = -1 },
+		"tampered quota":          func(o *TopUp) { o.CreditedQuota++ },
+		"overflow quota":          func(o *TopUp) { o.CreditedQuota = common.MaxWalletQuota + 1 },
+		"missing unit":            func(o *TopUp) { o.QuotaPerUnit = 0 },
+		"negative unit":           func(o *TopUp) { o.QuotaPerUnit = -1 },
+		"overflow unit":           func(o *TopUp) { o.QuotaPerUnit = common.MaxWalletQuota + 1 },
+		"missing rate":            func(o *TopUp) { o.DisplayRate = "" },
+		"zero rate":               func(o *TopUp) { o.DisplayRate = "0" },
+		"negative rate":           func(o *TopUp) { o.DisplayRate = "-7.3" },
+		"malformed rate":          func(o *TopUp) { o.DisplayRate = "7..3" },
+		"rate exponent":           func(o *TopUp) { o.DisplayRate = "1e-999999999" },
+		"rate too long":           func(o *TopUp) { o.DisplayRate = strings.Repeat("1", 65) },
+		"missing hash":            func(o *TopUp) { o.QuoteHash = "" },
+		"invalid hash":            func(o *TopUp) { o.QuoteHash = strings.Repeat("z", 64) },
+		"short hash":              func(o *TopUp) { o.QuoteHash = strings.Repeat("a", 63) },
+		"wrong money":             func(o *TopUp) { o.Money += 0.01 },
+		"fractional fen money":    func(o *TopUp) { o.Money += 0.001 },
+		"nan money":               func(o *TopUp) { o.Money = math.NaN() },
+		"infinite money":          func(o *TopUp) { o.Money = math.Inf(1) },
+	}
+	for name, mutate := range tests {
+		t.Run(name, func(t *testing.T) {
+			order := cnySnapshotTestOrder(100)
+			mutate(&order)
+			assert.True(t, order.HasCNYQuotaSnapshot())
+			_, err := order.settlementQuota()
+			require.ErrorIs(t, err, ErrInvalidTopUpQuota)
+			require.ErrorIs(t, order.Insert(), ErrInvalidTopUpQuota)
+		})
+	}
+	var nilOrder *TopUp
+	_, err := nilOrder.CNYQuotaSnapshot()
+	require.ErrorIs(t, err, ErrInvalidTopUpQuota)
+	for _, order := range []TopUp{
+		{Amount: 2, AmountFen: 100}, {Amount: 2, CreditedQuota: 100}, {Amount: 2, QuotaPerUnit: 500000},
+		{Amount: 2, Currency: "CNY"}, {Amount: 2, DisplayRate: "7.3"}, {Amount: 2, QuoteHash: strings.Repeat("a", 64)},
+	} {
+		assert.True(t, order.HasCNYQuotaSnapshot())
+		_, err := order.settlementQuota()
+		require.ErrorIs(t, err, ErrInvalidTopUpQuota)
+	}
+}
