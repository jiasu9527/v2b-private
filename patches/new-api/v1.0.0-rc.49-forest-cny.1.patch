+func TestCNYQuotaSnapshotSupportsYuanAndFen(t *testing.T) {
+	for _, fen := range []int64{100, 101, 123, 730, 1000, 1025, 100000, 100000000} {
+		t.Run(fmt.Sprint(fen), func(t *testing.T) {
+			order := cnySnapshotTestOrder(fen)
+			quota, err := order.CNYQuotaSnapshot()
+			require.NoError(t, err)
+			assert.Equal(t, int(order.CreditedQuota), quota)
+			displayedFen := decimal.NewFromInt(int64(quota)).Mul(decimal.RequireFromString(order.DisplayRate)).Mul(decimal.NewFromInt(100)).DivRound(decimal.NewFromInt(order.QuotaPerUnit), 0)
+			assert.Equal(t, fen, displayedFen.IntPart())
+		})
+	}
+}
