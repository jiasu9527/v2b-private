+func TestCNYCallbackRejectsSignedAmountMismatchBeforeSettlement(t *testing.T) {
+	truncateTables(t)
+	user := insertUserForPaymentGuardTest(t, 700, 0)
+	order := cnySnapshotTestOrder(123)
+	require.NoError(t, order.Insert())
+	for _, money := range []string{"0.01", "1.24", "", "1.230", "123e-2", "-1.23", "1.23.0"} {
+		done, err := RechargeEpay(order.TradeNo, "alipay", "127.0.0.1", money)
+		assert.False(t, done)
+		require.ErrorIs(t, err, ErrTopUpPaymentAmountMismatch)
+		assert.Equal(t, 0, getUserQuotaForPaymentGuardTest(t, user.Id))
+		assert.Equal(t, common.TopUpStatusPending, getTopUpStatusForPaymentGuardTest(t, order.TradeNo))
+	}
+	done, err := RechargeEpay(order.TradeNo, "alipay", "127.0.0.1", "1.23")
+	require.NoError(t, err)
+	assert.False(t, done)
+	done, err = RechargeEpay(order.TradeNo, "alipay", "127.0.0.1", "1.23")
+	require.NoError(t, err)
+	assert.True(t, done)
+	assert.Equal(t, int(order.CreditedQuota), getUserQuotaForPaymentGuardTest(t, user.Id))
+}
