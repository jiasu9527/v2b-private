+func (topUp *TopUp) HasCNYQuotaSnapshot() bool {
+	return topUp != nil && (topUp.AmountFen != 0 || topUp.CreditedQuota != 0 || topUp.QuotaPerUnit != 0 || topUp.Currency != "" || topUp.DisplayRate != "" || topUp.QuoteHash != "")
