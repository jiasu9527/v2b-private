+func cnySnapshotTestOrder(fen int64) TopUp {
+	rate := decimal.RequireFromString("7.3")
+	quota := decimal.NewFromInt(fen).Mul(decimal.NewFromInt(500000)).DivRound(rate.Mul(decimal.NewFromInt(100)), 0).IntPart()
+	money, _ := decimal.NewFromInt(fen).Div(decimal.NewFromInt(100)).Float64()
+	return TopUp{
+		UserId: 700, AmountFen: fen, Money: money, CreditedQuota: quota,
+		QuotaPerUnit: 500000, Currency: "CNY", DisplayRate: "7.3", QuoteHash: strings.Repeat("a", 64),
+		TradeNo: fmt.Sprintf("CNY-%d", fen), PaymentProvider: PaymentProviderEpay,
+		PaymentMethod: "alipay", Status: common.TopUpStatusPending, CreateTime: common.GetTimestamp(),
+	}
+}
