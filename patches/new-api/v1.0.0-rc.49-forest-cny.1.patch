+/** Convert a user-entered RMB amount without silently rounding a third decimal. */
+export function cnyAmountFen(amount: number): number | null {
+  if (!Number.isFinite(amount) || amount <= 0 || amount > 1000000) return null
+  const text = String(amount)
+  if (!/^\d+(?:\.\d{1,2})?$/.test(text)) return null
+  const [whole, fraction = ''] = text.split('.')
+  const fen = Number(whole) * 100 + Number(fraction.padEnd(2, '0'))
+  return Number.isSafeInteger(fen) ? fen : null
+}
+
+export function isCNYEpayMethod(
+  enabled: boolean,
+  paymentType: string
+): boolean {
+  return (
+    enabled &&
+    !isStripePayment(paymentType) &&
+    !isWaffoPayment(paymentType) &&
+    !isWaffoPancakePayment(paymentType)
+  )
+}
+
+// This page uses a single amount field before a gateway is selected. Keep
+// legacy units for mixed gateways until each provider supports RMB cents,
+// rather than silently interpreting one visible amount in two currencies.
+export function usesCNYTopupForm(info: TopupInfo | null): boolean {
+  return (
+    info?.supports_cny_amount_fen === true &&
+    !info.enable_stripe_topup &&
+    !info.enable_waffo_topup &&
+    !info.enable_waffo_pancake_topup &&
+    info.pay_methods.every((method) => isCNYEpayMethod(true, method.type))
+  )
+}
