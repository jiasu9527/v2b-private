+    if (!domain) {
+      domain = {
+        excluded: new Set(),
+        min: atom.key.includes(':') ? -Infinity : 0,
+        max: Infinity,
+        minOpen: false,
+        maxOpen: false,
+      }
+      domains.set(atom.key, domain)
+    }
