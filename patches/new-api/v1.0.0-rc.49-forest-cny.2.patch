+      if (!Number.isFinite(factor) || factor < 0) return null
+      const guards = [...a.guards, ...b.guards]
+      const matches = displayGuardsCanMatch(guards)
+      if (matches === null) return null
+      if (matches) rows.push({ tier: a.tier ?? b.tier, factor, guards })
+    }
+  }
