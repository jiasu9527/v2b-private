@@ -0,0 +1,94 @@
+package controller
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"math"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting/operation_setting"
+	"github.com/shopspring/decimal"
+)
+
+const maxCNYAmountFen int64 = 100000000
+
+type cnyTopupQuote struct {
+	AmountFen     int64  `json:"amount_fen"`
+	CreditedQuota int64  `json:"credited_quota"`
+	QuotaPerUnit  int64  `json:"quota_per_unit"`
+	Currency      string `json:"currency"`
+	DisplayRate   string `json:"display_rate"`
+	QuoteHash     string `json:"quote_hash"`
+}
+
+func cnyMinAmountFen() int64 { return max(100, int64(operation_setting.MinTopUp)*100) }
+
+func cnyTopupConfigValid(group string) bool {
+	if operation_setting.GetQuotaDisplayType() != operation_setting.QuotaDisplayTypeCNY {
+		return false
+	}
+	for _, v := range []float64{common.QuotaPerUnit, operation_setting.Price, operation_setting.USDExchangeRate} {
+		if v <= 0 || math.IsNaN(v) || math.IsInf(v, 0) {
+			return false
+		}
+	}
+	if common.QuotaPerUnit != math.Trunc(common.QuotaPerUnit) || common.QuotaPerUnit > common.MaxWalletQuota {
+		return false
+	}
+	if operation_setting.MinTopUp < 0 || operation_setting.MinTopUp > int(maxCNYAmountFen/100) {
+		return false
+	}
+	if !decimal.NewFromFloat(operation_setting.Price).Equal(decimal.NewFromFloat(operation_setting.USDExchangeRate)) {
+		return false
+	}
+	ratio := common.GetTopupGroupRatio(group)
+	if ratio != 0 && ratio != 1 {
+		return false
+	}
+	for _, discount := range operation_setting.GetPaymentSetting().AmountDiscount {
+		if math.IsNaN(discount) || math.IsInf(discount, 0) || (discount > 0 && discount != 1) {
+			return false
+		}
+	}
+	return true
+}
+
+// RMB cents are the external contract. Internal wallet quotas and model pricing
+// retain their original unit, including for pending orders created before this patch.
+func newCNYTopupQuote(userID int, group string, fen int64) (*cnyTopupQuote, error) {
+	if !cnyTopupConfigValid(group) {
+		return nil, common.NewMessage("CNY top-up configuration is unavailable. Please contact the administrator.")
+	}
+	if fen < cnyMinAmountFen() {
+		return nil, common.NewMessage("Top-up amount cannot be less than {{min}}", map[string]any{"min": decimal.NewFromInt(cnyMinAmountFen()).Div(decimal.NewFromInt(100)).StringFixed(2)})
+	}
+	if fen > maxCNYAmountFen {
+		return nil, common.NewMessage("Top-up amount cannot exceed {{max}}", map[string]any{"max": maxCNYAmountFen / 100})
+	}
+	rate := decimal.NewFromFloat(operation_setting.USDExchangeRate)
+	unit := decimal.NewFromFloat(common.QuotaPerUnit)
+	quota, err := validateCreditedQuota(decimal.NewFromInt(fen).Mul(unit).DivRound(rate.Mul(decimal.NewFromInt(100)), 0))
+	if err != nil {
+		return nil, err
+	}
+	// Credit rounding must not change the user's visible RMB cents.
+	if !decimal.NewFromInt(int64(quota)).Mul(rate).Mul(decimal.NewFromInt(100)).DivRound(unit, 0).Equal(decimal.NewFromInt(fen)) {
+		return nil, common.NewMessage("CNY top-up configuration is unavailable. Please contact the administrator.")
+	}
+	quote := &cnyTopupQuote{AmountFen: fen, CreditedQuota: int64(quota), QuotaPerUnit: int64(common.QuotaPerUnit), Currency: "CNY", DisplayRate: rate.String()}
+	// All configuration which changes eligibility or the amount is bound into the quote.
+	payload, err := common.Marshal(struct {
+		Version     int             `json:"version"`
+		UserID      int             `json:"user_id"`
+		Group       string          `json:"group"`
+		MinFen      int64           `json:"min_amount_fen"`
+		GroupRatios string          `json:"group_ratios"`
+		Discounts   map[int]float64 `json:"discounts"`
+		Quote       *cnyTopupQuote  `json:"quote"`
+	}{1, userID, group, cnyMinAmountFen(), common.TopupGroupRatio2JSONString(), operation_setting.GetPaymentSetting().AmountDiscount, quote})
+	if err != nil {
+		return nil, err
+	}
+	quote.QuoteHash = fmt.Sprintf("%x", sha256.Sum256(payload))
+	return quote, nil
+}
