+  depth = 0
+): DisplayBranch[] | null {
+  if (depth > 64) return null
+  const scalar = nonnegativePriceLiteral(node)
+  if (scalar !== null) {
+    return Number.isFinite(scalar) ? [{ factor: scalar, guards: [] }] : null
+  }
+  const tier = tokenTier(node, [])
+  if (tier) return [{ factor: 1, tier, guards: [] }]
+  if (node.kind === 'conditional') {
+    if (!displayGuardAlternatives(node.condition, true)) return null
+    const yes = displayPricingBranches(node.yes, depth + 1)
+    const no = displayPricingBranches(node.no, depth + 1)
+    if (!yes || !no || yes.length + no.length > MAX_DISPLAY_BRANCHES) {
+      return null
+    }
+    return [
+      ...yes.map((row) => ({
+        ...row,
+        guards: [{ condition: node.condition, matches: true }, ...row.guards],
+      })),
+      ...no.map((row) => ({
+        ...row,
+        guards: [{ condition: node.condition, matches: false }, ...row.guards],
+      })),
+    ]
+  }
+  if (node.kind !== 'binary' || node.operator !== '*') return null
+  const left = displayPricingBranches(node.left, depth + 1)
+  const right = displayPricingBranches(node.right, depth + 1)
+  if (!left || !right || left.length * right.length > MAX_DISPLAY_BRANCHES) {
+    return null
+  }
