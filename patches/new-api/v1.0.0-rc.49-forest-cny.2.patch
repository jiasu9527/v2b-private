+func assertCNYConcurrentSettlementCreditOnce(t *testing.T) {
+	t.Helper()
+	user := insertUserForPaymentGuardTest(t, 700, 0)
+	order := cnySnapshotTestOrder(123)
+	require.NoError(t, order.Insert())
+	errors := make(chan error, 24)
+	var wg sync.WaitGroup
+	for i := 0; i < 24; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if i%2 == 0 {
+				_, err := RechargeEpay(order.TradeNo, "alipay", "127.0.0.1")
+				errors <- err
+			} else {
+				errors <- ManualCompleteTopUp(order.TradeNo, "127.0.0.1")
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errors)
+	for err := range errors {
+		require.NoError(t, err)
+	}
+	assert.Equal(t, int(order.CreditedQuota), getUserQuotaForPaymentGuardTest(t, user.Id))
+	assert.Equal(t, common.TopUpStatusSuccess, getTopUpStatusForPaymentGuardTest(t, order.TradeNo))
+	var logs int64
+	require.NoError(t, LOG_DB.Model(&Log{}).Where("type = ?", LogTypeTopup).Count(&logs).Error)
+	assert.Equal(t, int64(1), logs)
+}
